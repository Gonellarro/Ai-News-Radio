NEWS_RADIO_IMAGE=news-radio:0.1.0
NEWS_RADIO_PORT=8790
NEWS_RADIO_LOG_LEVEL=INFO
NEWS_RADIO_UID=1000
NEWS_RADIO_GID=1000
NEWS_RADIO_REFRESH_SECONDS=1800
NEWS_RADIO_REDDIT_INTERVAL_SECONDS=7200
NEWS_RADIO_REDDIT_REQUEST_GAP_SECONDS=1800
NEWS_RADIO_REDDIT_COOLDOWN_SECONDS=21600
SEARXNG_URL=http://192.168.1.9:8888
# Motores adicionales por consulta, sin modificar la instancia SearXNG.
SEARXNG_GENERAL_ENGINES=
SEARXNG_FALLBACK_ENGINES=bing
SEARXNG_NEWS_ENGINES=
# Desarrollo Linux: la red del host permite usar Ollama en localhost.
# Descomenta para otro servidor; en despliegue con red bridge debe ser accesible desde Docker.
# OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=hf.co/lmstudio-community/gemma-4-E2B-it-GGUF:Q4_K_M
OLLAMA_TIMEOUT_SECONDS=300
