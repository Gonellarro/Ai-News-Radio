# Copy to .env. These values are not shell commands.
COMPOSE_PROJECT_NAME=ai-news-radio
APP_UID=1000
APP_GID=1000
STATE_DIR=./state

# Optional services: empty, qwen, youtube, or qwen,youtube.
COMPOSE_PROFILES=
# TTS_ENGINE and INITIAL_* only seed a new channel.json; use the web afterward.
TTS_ENGINE=piper
INITIAL_AUTOMATION_ENABLED=false
CHANNEL_NAME=Noticias de inteligencia artificial
CHANNEL_TOPIC=Inteligencia artificial
SCHEDULE_TIMEZONE=Europe/Madrid

# Local access by default. For a trusted LAN use BIND_ADDRESS=0.0.0.0.
BIND_ADDRESS=127.0.0.1
DASHBOARD_PORT=8792
NEWS_RADIO_PORT=8790
QWENTTS_PORT=8791
QWENTTS_PUBLIC_URL=http://localhost:8791

# Official Ollama 0.40.5, pinned manifest. Override deliberately on upgrade.
OLLAMA_IMAGE=ollama/ollama:0.40.5@sha256:5d3a2f25f9825628daba94dc0b1d421c7d57d6c03ae5faa9ba050e058bab8241
OLLAMA_MODEL=hf.co/lmstudio-community/gemma-4-E2B-it-GGUF:Q4_K_M
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_CPUS=2.0
OLLAMA_MEMORY_LIMIT=4g
SOURCE_REFRESH_SECONDS=3600
# Optional external SearXNG. No dependency on any particular local IP.
SEARXNG_URL=
SEARXNG_FALLBACK_ENGINES=

ORCHESTRATOR_CPUS=1.0
ORCHESTRATOR_MEMORY_LIMIT=512m
NEWS_RADIO_CPUS=0.5
NEWS_RADIO_MEMORY_LIMIT=256m
QWEN_CPUS=2.0
QWEN_MEMORY_LIMIT=5500m
QWEN_THREADS=2
QWEN_DTYPE=float32
QWEN_CHUNK_CHARS=160
QWEN_JOB_TIMEOUT=1800
